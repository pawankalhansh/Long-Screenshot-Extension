{
  "manifest_version": 3,
  "name": "Long Screenshot",
  "version": "1.0",
  "description": "Capture full page, visible screen, or specific areas with a premium Edge-like UI.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "action": {
    "default_title": "Take Screenshot"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Take Screenshot"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": []
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
