{
  "manifest_version": 3,
  "name": "Long Screenshot",
  "version": "1.0",
  "description": "Capture full page, visible screen, or specific areas with a premium Edge-like UI.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Take Screenshot",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Take Screenshot"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["result.html", "result.css", "result.js", "editor.js", "tesseract/*", "tesseract/lang-data/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": []
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
